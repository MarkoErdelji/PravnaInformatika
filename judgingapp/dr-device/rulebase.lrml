                        <ruleml:Var>Years</ruleml:Var>
                        <ruleml:Ind>1</ruleml:Ind>
                    </ruleml:Atom>
                </lrml:Obligation>
            </lrml:SuborderList>
        </lrml:PenaltyStatement>

        <lrml:PenaltyStatement key="pen_lv4_max">
            <lrml:SuborderList>
                <lrml:Obligation>
