                <lrml:toPrescriptiveStatement keyref="#ps12"/>
            </lrml:Reparation>
        </lrml:ReparationStatement>

        <lrml:ReparationStatement>
            <lrml:Reparation>
                <lrml:appliesPenalty keyref="#pen_lv5_max"/>
                <lrml:toPrescriptiveStatement keyref="#ps12"/>
            </lrml:Reparation>
        </lrml:ReparationStatement>

        <lrml:ReparationStatement>
            <lrml:Reparation>
                <lrml:appliesPenalty keyref="#pen_lv6_min"/>
                <lrml:toPrescriptiveStatement keyref="#ps17"/>
            </lrml:Reparation>
        </lrml:ReparationStatement>


        <!-- Override Statements - NOW ALL HIGHER LEVELS NEGATE ALL LOWER LEVELS -->
        <lrml:OverrideStatement>
            <lrml:Override under="#ps2" over="#ps3"/>
        </lrml:OverrideStatement>
        <lrml:OverrideStatement>
            <lrml:Override under="#ps1" over="#ps3"/>
        </lrml:OverrideStatement>
        <lrml:OverrideStatement>
            <lrml:Override under="#ps1" over="#ps4"/>
        </lrml:OverrideStatement>
