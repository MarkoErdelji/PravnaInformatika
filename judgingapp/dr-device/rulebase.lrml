                        <ruleml:Var>Years</ruleml:Var>
                        <ruleml:Ind>10</ruleml:Ind>
                    </ruleml:Atom>
                </lrml:Obligation>
            </lrml:SuborderList>
        </lrml:PenaltyStatement>

        <lrml:PenaltyStatement key="pen_lv4_min">
            <lrml:SuborderList>
                <lrml:Obligation>
